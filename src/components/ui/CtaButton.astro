---
/**
 * CtaButton — 萤火绿渐变胶囊 CTA（内嵌箭头 ↗ 圆形容器）
 * 视觉基准：萤火绿 #BCF01B 渐变 + 墨字 + 独立圆形箭头容器（悬停斜移放大）
 * 本组件自带 .cta 样式模式（global.css 未定义 .cta，故由本组件内聚定义）。
 * 交互仅 CSS hover/active；需要磁吸交互时使用 motion/MagneticButton.tsx。
 */
interface Props {
  label: string;
  href: string;
}
const { label, href } = Astro.props;
---
<a href={href} class="cta">
  <span class="cta-label">{label}</span>
  <span class="cta-arrow" aria-hidden="true">↗</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 8px 9px 8px 28px;
    border-radius: 999px;
    background: linear-gradient(135deg, #cdf33a, var(--firefly));
    color: var(--ink);
    font-family: var(--font-kanit);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    white-space: nowrap;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      0 0 0 1px rgba(27, 25, 18, 0.08),
      0 16px 40px -12px rgba(188, 240, 27, 0.85);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .cta:hover {
    transform: scale(1.03);
  }
  .cta:active {
    transform: scale(0.97);
  }
  .cta-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(27, 25, 18, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .cta:hover .cta-arrow {
    transform: translate(3px, -3px) scale(1.06);
  }
</style>
