---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import { SITE } from '../../config';

/**
 * 项目详情页 — /projects/[slug]
 * 简历式项目介绍：hero（编号/分类/标题）→ 简介 → 技术栈 chips → 关键成果 metrics
 * → 链接（如有）→ 正文（markdown：简介/技术/难点/成果/复盘）
 */
export async function getStaticPaths() {
  const projects = (
    await getCollection('projects', ({ data }) => !data.draft)
  ).sort((a, b) => a.data.num.localeCompare(b.data.num));
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, num, cat, summary, tech, metrics, links } = project.data;
---
<PageLayout title={`${title} · ${SITE.name}`} description={summary} active="项目">
  <article class="proj-page">
    <a href="/" class="back">← 返回首页</a>

    <header class="proj-hero">
      <span class="proj-num" aria-hidden="true">{num}</span>
      <div class="proj-hero-info">
        <Eyebrow text="Project Case" />
        <h1 class="proj-title gtext">{title}</h1>
        <div class="proj-cat" set:html={cat} />
      </div>
    </header>

    <p class="proj-summary">{summary}</p>

    <div class="proj-tech">
      {tech.map((t) => (
        <span key={t}>{t}</span>
      ))}
    </div>

    {metrics.length > 0 && (
      <div class="proj-metrics">
        {metrics.map((m) => (
          <div class="proj-metric" key={m.label}>
            <b>{m.value}</b>
            <span>{m.label}</span>
          </div>
        ))}
      </div>
    )}

    {(links?.demo || links?.github) && (
      <div class="proj-links">
        {links.demo && (
          <a href={links.demo} target="_blank" rel="noreferrer" class="proj-link">
            在线 Demo ↗
          </a>
        )}
        {links.github && (
          <a href={links.github} target="_blank" rel="noreferrer" class="proj-link">
            GitHub ↗
          </a>
        )}
      </div>
    )}

    <div class="proj-body prose-article">
      <Content />
    </div>
  </article>
</PageLayout>

<style>
  .proj-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 24px 120px;
  }
  .back {
    display: inline-block;
    font-family: var(--font-kanit);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.5s var(--ease-out);
  }
  .back:hover {
    color: var(--firefly-deep);
  }

  .proj-hero {
    display: flex;
    align-items: flex-start;
    gap: 22px;
    margin-top: 26px;
  }
  .proj-num {
    font-family: var(--font-kanit);
    font-size: clamp(48px, 9vw, 110px);
    font-weight: 900;
    line-height: 0.9;
    color: rgba(27, 25, 18, 0.12);
    flex-shrink: 0;
  }
  .proj-hero-info {
    flex: 1;
  }
  .proj-title {
    margin-top: 16px;
    font-family: var(--font-heading);
    font-size: clamp(36px, 7.5vw, 88px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .proj-cat {
    margin-top: 10px;
    font-family: var(--font-kanit);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .proj-cat :global(b) {
    color: var(--firefly-deep);
    font-weight: 600;
  }

  .proj-summary {
    margin-top: 30px;
    font-size: clamp(15px, 1.7vw, 18px);
    font-weight: 300;
    line-height: 1.8;
    color: var(--ink);
    max-width: 640px;
  }

  .proj-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .proj-tech span {
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid rgba(27, 25, 18, 0.14);
    background: rgba(255, 255, 255, 0.6);
    font-family: var(--font-kanit);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .proj-metrics {
    display: flex;
    gap: 34px;
    margin-top: 24px;
    padding: 20px 24px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(27, 25, 18, 0.08);
    flex-wrap: wrap;
  }
  .proj-metric b {
    display: block;
    font-family: var(--font-kanit);
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--firefly-deep);
  }
  .proj-metric span {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .proj-links {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }
  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    border-radius: 999px;
    background: var(--firefly);
    color: var(--ink);
    font-family: var(--font-kanit);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 0 0 1px rgba(27, 25, 18, 0.08);
  }

  .proj-body {
    margin-top: 40px;
  }
</style>
