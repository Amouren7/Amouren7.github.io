---
/**
 * 关于页 — /about（求职作品集）
 * Hero 大字「关于」→ 当前经历 → AI 能力 → 代表性项目（DoubleBezel 网格）
 * → 联系方式（email / GitHub）
 */
import PageLayout from '../layouts/PageLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import DoubleBezel from '../components/ui/DoubleBezel.astro';
import ScrollFade from '../components/motion/ScrollFade.tsx';
import { getCollection } from 'astro:content';
import { SITE, SKILLS, TOOLCHAIN_GROUPS } from '../config';

// 代表性项目（来自 content/projects，链到详情页 /projects/[slug]）
const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
)
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.num.localeCompare(b.data.num));
---
<PageLayout title={`关于 · ${SITE.name}`} description="姜高辉，软件工程背景，现于深圳市广源达印刷包装有限公司从事 AI 应用落地。" active="关于">
  {/* ---------- HERO ---------- */}
  <section class="ab-hero">
    <ScrollFade client:load>
      <Eyebrow text={SITE.heroEyebrow} />
      <h1 class="ab-title gtext">关于</h1>
      <p class="ab-lead">{SITE.author} · 软件工程背景 · 深圳</p>
      <p class="ab-desc">
        现于深圳市广源达印刷包装有限公司从事 AI 应用落地，关注大模型如何进入真实业务流程。围绕销售沟通、客户信息处理与工作流自动化，从需求梳理、原型验证到试点迭代，持续把 AI 做成一线人员能用的工具。
      </p>
      <div class="ab-lvl">
        <span class="ab-lvl-dot" aria-hidden="true" />
        Shenzhen · AI Application Delivery
      </div>
    </ScrollFade>
  </section>

  {/* ---------- 当前工作经历 ---------- */}
  <section class="ab-experience" aria-label="当前工作经历">
    <div class="ab-exp-card">
      <div class="ab-exp-date">
        <Eyebrow text="Experience · 01" />
        <time datetime="2026-08">2026.08 — 至今</time>
      </div>
      <div class="ab-exp-main">
        <h2>深圳市广源达印刷包装有限公司</h2>
        <p class="ab-exp-role">AI 应用落地</p>
        <ul>
          <li>梳理印刷包装业务流程，识别适合 AI 辅助的具体工作环节。</li>
          <li>推动销售沟通辅助、客户信息整理等应用进入业务验证与持续迭代。</li>
          <li>兼顾使用体验、信息保护、人工确认和交付后的维护。</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- AI 能力 ---------- */}
  <section class="ab-skills">
    <div class="ab-skills-inner">
      <div class="ab-skills-head">
        <Eyebrow text="Skills · Focus" />
        <h2 class="ab-skills-title gtext-light">技能</h2>
      </div>
      <div class="ab-skills-list">
        {SKILLS.map((skill) => (
          <div class="ab-skill">
            <div class="ab-skill-num">{skill.num}</div>
            <div class="ab-skill-body">
              <h3>{skill.name}</h3>
              <div class="ab-skill-wuxing">{skill.wuxing}</div>
              <p>{skill.desc}</p>
            </div>
            <span class="ab-skill-arr" aria-hidden="true">↗</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- 代表性项目 ---------- */}
  <section class="ab-projects" id="projects">
    <ScrollFade client:load>
      <div class="ab-projects-head">
        <Eyebrow text="Selected Work · AI" />
        <h2 class="ab-projects-title gtext">项目案例</h2>
        <p class="ab-projects-note">以下界面均为脱敏演示图，画面内容与字段采用合成示例。</p>
      </div>
      <div class="ab-projects-grid">
        {projects.map((p) => (
          <a href={`/projects/${p.slug}`} class="ab-proj-card">
            <DoubleBezel>
              <div class="ab-proj-core">
                <div class="ab-proj-top">
                  <div class="ab-proj-num">{p.data.num}</div>
                  <div class="ab-proj-info">
                    <div class="ab-proj-cat" set:html={p.data.cat} />
                    <h3>{p.data.title}</h3>
                  </div>
                  <span class="ab-proj-ghost">
                    详情 <span class="ab-proj-ghost-arr">↗</span>
                  </span>
                </div>
                <p class="ab-proj-summary">{p.data.summary}</p>
                {p.data.preview && (
                  <figure class="ab-proj-preview">
                    <img
                      src={p.data.preview.src}
                      alt={p.data.preview.alt}
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>{p.data.preview.caption}</figcaption>
                  </figure>
                )}
              </div>
            </DoubleBezel>
          </a>
        ))}
      </div>
    </ScrollFade>
  </section>

  {/* ---------- AI 工具链 Toolbox ---------- */}
  <section class="ab-toolbox">
    <ScrollFade client:load>
      <div class="ab-toolbox-head">
        <Eyebrow text="Toolbox" />
        <h2 class="ab-toolbox-title gtext">能力与方法</h2>
        <p class="ab-toolbox-desc">
          从业务问题到稳定使用，覆盖模型应用、知识检索、流程自动化与工程验证。
        </p>
      </div>
      <div class="ab-toolbox-grid">
        {TOOLCHAIN_GROUPS.map((group) => (
          <DoubleBezel>
            <div class="ab-tb-group">
              <div class="ab-tb-cat">{group.cat}</div>
              <ul>
                {group.tools.map((tool) => (
                  <li key={tool.name}>
                    <b>{tool.name}</b>
                    <span>{tool.role}</span>
                  </li>
                ))}
              </ul>
            </div>
          </DoubleBezel>
        ))}
      </div>
    </ScrollFade>
  </section>

  {/* ---------- 联系方式 ---------- */}
  <section class="ab-contact" id="contact">
    <ScrollFade client:load>
      <Eyebrow text="Contact" />
      <h2 class="ab-contact-title gtext">联系</h2>
      <div class="ab-contact-rows">
        <a href={`mailto:${SITE.email}`} class="ab-contact-row">
          <span class="ab-contact-label">Email</span>
          <span class="ab-contact-value">{SITE.email} ↗</span>
        </a>
        <a
          href="https://github.com/Amouren7"
          target="_blank"
          rel="noreferrer"
          class="ab-contact-row"
        >
          <span class="ab-contact-label">GitHub</span>
          <span class="ab-contact-value">Amouren7 ↗</span>
        </a>
      </div>
      <p class="ab-contact-note">简历 / 合作 / 命理咨询，欢迎来信。</p>
    </ScrollFade>
  </section>
</PageLayout>

<style>
  /* ---------- HERO ---------- */
  .ab-hero {
    min-height: 72dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 70px 24px 100px;
    position: relative;
    background: radial-gradient(
        50% 40% at 50% 0%,
        rgba(188, 240, 27, 0.1),
        transparent 60%
      );
  }

  .ab-experience {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px 100px;
  }
  .ab-exp-card {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) 2fr;
    gap: 34px;
    padding: clamp(24px, 4vw, 42px);
    border: 1px solid rgba(27, 25, 18, 0.1);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.54);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.88);
  }
  .ab-exp-date time {
    display: block;
    margin-top: 16px;
    font-family: var(--font-kanit);
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--firefly-deep);
  }
  .ab-exp-main h2 {
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.35;
  }
  .ab-exp-role {
    margin-top: 5px;
    color: var(--firefly-deep);
    font-size: 14px;
    font-weight: 700;
  }
  .ab-exp-main ul {
    display: grid;
    gap: 9px;
    margin: 20px 0 0;
    padding-left: 1.2em;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.7;
  }
  .ab-exp-main li::marker { color: var(--firefly-deep); }
  .ab-title {
    font-family: var(--font-kanit);
    font-size: clamp(64px, 15vw, 170px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin-top: 24px;
  }
  .ab-lead {
    margin-top: 28px;
    font-family: var(--font-serifsc);
    font-size: clamp(15px, 2vw, 20px);
    font-weight: 700;
    color: var(--ink);
  }
  .ab-desc {
    max-width: 560px;
    margin: 18px auto 0;
    font-size: clamp(13px, 1.8vw, 16px);
    line-height: 1.9;
    color: var(--ink-soft);
  }
  .ab-lvl {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 30px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid rgba(27, 25, 18, 0.16);
    background: rgba(255, 255, 255, 0.55);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  .ab-lvl-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--firefly-deep);
    box-shadow: 0 0 10px rgba(188, 240, 27, 0.8);
  }

  /* ---------- 技能（夜区块） ---------- */
  .ab-skills {
    background: radial-gradient(
        60% 60% at 50% 0%,
        rgba(188, 240, 27, 0.06),
        transparent 55%
      ),
      var(--night);
    color: var(--night-text);
    border-radius: 40px 40px 0 0;
    padding: 100px 22px 74px;
    position: relative;
  }
  .ab-skills-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .ab-skills-head {
    text-align: center;
    margin-bottom: 24px;
  }
  .ab-skills-title {
    font-family: var(--font-kanit);
    font-size: clamp(40px, 9vw, 96px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: 20px;
  }
  .ab-skill {
    display: flex;
    gap: 26px;
    align-items: flex-start;
    padding: 34px 8px;
    border-top: 1px solid rgba(231, 224, 207, 0.12);
  }
  .ab-skill:last-child {
    border-bottom: 1px solid rgba(231, 224, 207, 0.12);
  }
  .ab-skill-num {
    font-family: var(--font-kanit);
    font-size: clamp(40px, 8vw, 88px);
    font-weight: 900;
    line-height: 0.9;
    min-width: 96px;
    color: var(--firefly);
    text-shadow: 0 0 24px rgba(188, 240, 27, 0.35);
    opacity: 0.85;
    transition: opacity 0.6s var(--ease-out), text-shadow 0.6s var(--ease-out);
  }
  .ab-skill:hover .ab-skill-num {
    opacity: 1;
    text-shadow: 0 0 34px rgba(188, 240, 27, 0.6);
  }
  .ab-skill-body {
    flex: 1;
  }
  .ab-skill-body h3 {
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .ab-skill-wuxing {
    font-size: 10px;
    letter-spacing: 0.26em;
    color: var(--firefly);
    margin-top: 5px;
    text-transform: uppercase;
  }
  .ab-skill-body p {
    margin: 10px 0 0;
    font-size: clamp(12px, 1.5vw, 15px);
    font-weight: 300;
    line-height: 1.7;
    opacity: 0.65;
    max-width: 520px;
  }
  .ab-skill-arr {
    margin-left: auto;
    align-self: center;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
    font-size: 18px;
    color: var(--firefly);
  }
  .ab-skill:hover .ab-skill-arr {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* ---------- 项目 ---------- */
  .ab-projects {
    background: radial-gradient(
        46% 40% at 50% 0%,
        rgba(188, 240, 27, 0.1),
        transparent 60%
      ),
      var(--paper);
    border-radius: 40px 40px 0 0;
    margin-top: -26px;
    position: relative;
    z-index: 3;
    padding: 100px 16px 60px;
  }
  .ab-projects-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .ab-projects-note {
    max-width: 620px;
    margin: 16px auto 0;
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.6;
  }
  .ab-projects-title {
    font-family: var(--font-kanit);
    font-size: clamp(40px, 9vw, 96px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: 20px;
  }
  .ab-projects-grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }
  .ab-proj-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.7s var(--ease-out);
    will-change: transform;
  }
  .ab-proj-card:hover {
    transform: translateY(-4px);
  }
  .ab-proj-core {
    padding: 20px;
  }
  .ab-proj-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    flex-wrap: wrap;
  }
  .ab-proj-num {
    font-family: var(--font-kanit);
    font-size: clamp(42px, 7vw, 76px);
    font-weight: 900;
    line-height: 0.9;
    color: rgba(27, 25, 18, 0.13);
    transition: color 0.6s var(--ease-out);
  }
  .ab-proj-card:hover .ab-proj-num {
    color: var(--firefly-deep);
  }
  .ab-proj-info {
    flex: 1;
    min-width: 160px;
  }
  .ab-proj-cat {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .ab-proj-cat b {
    color: var(--firefly-deep);
    font-weight: 600;
  }
  .ab-proj-info h3 {
    font-size: clamp(19px, 2.6vw, 28px);
    font-weight: 700;
    text-transform: uppercase;
    margin-top: 2px;
  }
  .ab-proj-summary {
    margin: 16px 2px 0;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.7;
  }
  .ab-proj-preview {
    position: relative;
    overflow: hidden;
    margin: 18px 0 0;
    border: 1px solid rgba(27, 25, 18, 0.1);
    border-radius: 16px;
    background: #eee9dc;
    aspect-ratio: 16 / 9;
  }
  .ab-proj-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ab-proj-preview figcaption {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 5px 9px;
    border: 1px solid rgba(27, 25, 18, 0.12);
    border-radius: 999px;
    background: rgba(244, 240, 229, 0.88);
    color: var(--ink-soft);
    font-size: 10px;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
  }
  .ab-proj-ghost {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 7px 7px 18px;
    border-radius: 999px;
    border: 1px solid rgba(27, 25, 18, 0.22);
    color: var(--ink);
    background: transparent;
    font-family: var(--font-kanit);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.6s var(--ease-out), border-color 0.6s var(--ease-out);
  }
  .ab-proj-ghost-arr {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(27, 25, 18, 0.07);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.7s var(--ease-out);
  }
  .ab-proj-card:hover .ab-proj-ghost {
    background: rgba(143, 191, 11, 0.14);
    border-color: rgba(143, 191, 11, 0.5);
  }
  .ab-proj-card:hover .ab-proj-ghost-arr {
    transform: translate(2px, -2px);
  }

  /* ---------- 联系 ---------- */
  /* ---------- AI 工具链 Toolbox ---------- */
  .ab-toolbox {
    max-width: 960px;
    margin: 0 auto;
    padding: 90px 24px 40px;
  }
  .ab-toolbox-head {
    text-align: center;
  }
  .ab-toolbox-title {
    margin-top: 24px;
    font-family: var(--font-heading);
    font-size: clamp(40px, 9vw, 96px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .ab-toolbox-desc {
    margin: 18px auto 0;
    max-width: 520px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .ab-toolbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    margin-top: 44px;
  }
  .ab-tb-group {
    padding: 22px;
  }
  .ab-tb-cat {
    font-family: var(--font-kanit);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--firefly-deep);
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(27, 25, 18, 0.08);
    margin-bottom: 14px;
  }
  .ab-tb-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ab-tb-group li b {
    display: block;
    font-family: var(--font-kanit);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    transition: color 0.5s var(--ease-out);
  }
  .ab-tb-group li:hover b {
    color: var(--firefly-deep);
  }
  .ab-tb-group li span {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .ab-contact {
    max-width: 720px;
    margin: 0 auto;
    padding: 90px 24px 110px;
    text-align: center;
    scroll-margin-top: 96px;
  }
  .ab-contact-title {
    font-family: var(--font-kanit);
    font-size: clamp(40px, 9vw, 96px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: 20px;
  }
  .ab-contact-rows {
    max-width: 460px;
    margin: 40px auto 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .ab-contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    border-radius: 16px;
    border: 1px solid rgba(27, 25, 18, 0.1);
    background: rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.6s var(--ease-out), background 0.6s var(--ease-out);
    will-change: transform;
  }
  .ab-contact-row:hover {
    transform: translateY(-3px);
    background: rgba(188, 240, 27, 0.16);
  }
  .ab-contact-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ab-contact-value {
    font-family: var(--font-kanit);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--firefly-deep);
  }
  .ab-contact-note {
    margin-top: 26px;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  /* ---------- 响应式 ---------- */
  @media (max-width: 700px) {
    .ab-skills {
      padding: 80px 18px 60px;
    }
    .ab-skill {
      gap: 16px;
      padding: 26px 4px;
    }
    .ab-skill-num {
      min-width: 64px;
    }
    .ab-experience { padding: 0 18px 70px; }
    .ab-exp-card { grid-template-columns: 1fr; gap: 22px; }
    .ab-projects-grid { grid-template-columns: 1fr; max-width: 620px; }
  }

  .ab-proj-card:focus-visible {
    outline: 3px solid var(--firefly-deep);
    outline-offset: 5px;
    border-radius: 22px;
  }
</style>
