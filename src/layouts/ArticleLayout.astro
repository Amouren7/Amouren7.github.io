---
/**
 * ArticleLayout — 文章页壳
 * - PageLayout（导航 / 页脚 / 搜索入口）+ 文章头（栏目 pill + 大字标题 + 日期 + 阅读时间 + 标签）
 * - 目录 TOC：由 headings（render 返回的 h2/h3）生成锚点列表，桌面 sticky 侧栏，移动端隐藏
 * - 正文走 .prose-article（global.css），约 720px 居中
 * - 底部上一篇 / 下一篇卡片（按 pubDate 相邻）
 */
import PageLayout from './PageLayout.astro';
import { CATEGORIES } from '../config';
import type { CategoryKey } from '../config';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  /** h1 大标题（默认取 title；文章页传纯文章标题，title 带站点名用于 head） */
  heading?: string;
  /** ISO 日期，如 2026-07-20 */
  pubDate?: string;
  readingTime?: number;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
  tags?: string[];
  category?: CategoryKey;
  headings?: TocHeading[];
}

const {
  title = '文章',
  description,
  heading,
  pubDate,
  readingTime,
  prev,
  next,
  tags = [],
  category,
  headings = [],
} = Astro.props;

const h1 = heading ?? title;

const catMeta = category ? CATEGORIES[category] : undefined;
const activeMap: Record<string, string> = { ai: '项目', mingli: '命理', life: '生活' };
const active = category ? activeMap[category] : undefined;

const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const dateLabel = pubDate
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(
      new Date(pubDate),
    )
  : undefined;
---
<PageLayout title={title} description={description} active={active}>
  <article class="art">
    <header class="art-head">
      <div class="art-eyebrow">
        {catMeta && (
          <a class="art-cat" href={catMeta.href}>{catMeta.label} ↗</a>
        )}
      </div>
      <h1 class="art-title gtext">{h1}</h1>
      <div class="art-meta">
        {dateLabel && (
          <time datetime={pubDate} class="art-date">{dateLabel}</time>
        )}
        {readingTime && (
          <>
            <span class="art-dot" aria-hidden="true">·</span>
            <span>{readingTime} 分钟阅读</span>
          </>
        )}
      </div>
      {tags.length > 0 && (
        <div class="art-tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="art-tag">#{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="art-body">
      {tocItems.length > 0 && (
        <aside class="toc" aria-label="目录">
          <p class="toc-label">目录 · TOC</p>
          <ol class="toc-list">
            {tocItems.map((h) => (
              <li class:list={['toc-item', h.depth === 3 && 'toc-item-sub']}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}

      <div class="art-prose prose-article">
        <slot />
      </div>
    </div>

    <nav class="pn" aria-label="上一篇 / 下一篇">
      {prev ? (
        <a href={prev.href} class="pn-card">
          <span class="pn-dir">← 上一篇</span>
          <h4 class="pn-title">{prev.title}</h4>
        </a>
      ) : (
        <span class="pn-card pn-empty" aria-hidden="true" />
      )}
      {next ? (
        <a href={next.href} class="pn-card pn-next">
          <span class="pn-dir">下一篇 →</span>
          <h4 class="pn-title">{next.title}</h4>
        </a>
      ) : (
        <span class="pn-card pn-empty" aria-hidden="true" />
      )}
    </nav>
  </article>
</PageLayout>

<style>
  .art {
    padding: 46px 20px 80px;
  }

  /* ---------- 文章头 ---------- */
  .art-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px;
  }
  .art-eyebrow {
    display: flex;
    justify-content: center;
  }
  .art-cat {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--firefly-deep);
    text-decoration: none;
    padding: 7px 18px;
    border-radius: 999px;
    border: 1px solid rgba(143, 191, 11, 0.4);
    background: rgba(188, 240, 27, 0.1);
    transition: background 0.6s var(--ease-out), color 0.6s var(--ease-out);
  }
  .art-cat:hover {
    background: rgba(188, 240, 27, 0.35);
    color: var(--ink);
  }
  .art-title {
    font-family: 'Kanit', 'Noto Serif SC', serif;
    font-size: clamp(34px, 7vw, 74px);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-top: 22px;
    text-wrap: balance;
  }
  .art-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .art-dot {
    color: var(--firefly-deep);
  }
  .art-tags {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .art-tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--firefly-deep);
    text-decoration: none;
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid rgba(143, 191, 11, 0.35);
    transition: background 0.6s var(--ease-out), color 0.6s var(--ease-out);
  }
  .art-tag:hover {
    background: rgba(188, 240, 27, 0.35);
    color: var(--ink);
  }

  /* ---------- 正文网格（TOC + prose） ---------- */
  .art-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 720px);
    gap: 48px;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .toc {
    position: sticky;
    top: 112px;
    align-self: start;
    justify-self: end;
    width: 220px;
    max-height: calc(100dvh - 130px);
    overflow-y: auto;
    padding: 14px 16px;
    border-left: 1px solid rgba(27, 25, 18, 0.1);
  }
  .toc-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .toc-item a {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 4px 0;
    transition: color 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .toc-item a:hover {
    color: var(--firefly-deep);
    transform: translateX(3px);
  }
  .toc-item-sub {
    padding-left: 14px;
  }
  .toc-item-sub a {
    font-size: 12px;
  }
  .art-prose {
    max-width: 720px;
    min-width: 0;
    padding-bottom: 20px;
  }

  /* 锚点跳转不被固定导航遮挡 */
  .art-prose :global(h2),
  .art-prose :global(h3),
  .art-prose :global(h4) {
    scroll-margin-top: 120px;
  }

  /* ---------- 上一篇 / 下一篇 ---------- */
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 1060px;
    margin: 64px auto 0;
    padding: 0 16px;
  }
  .pn-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border-radius: 20px;
    border: 1px solid rgba(27, 25, 18, 0.1);
    background: rgba(255, 255, 255, 0.6);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 14px 34px -20px rgba(27, 25, 18, 0.35);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.7s var(--ease-out), background 0.6s var(--ease-out);
    will-change: transform;
  }
  .pn-card:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.85);
  }
  .pn-next {
    text-align: right;
    align-items: flex-end;
  }
  .pn-dir {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--firefly-deep);
  }
  .pn-title {
    font-family: var(--font-serifsc);
    font-size: 16px;
    font-weight: 700;
    margin: 0;
    line-height: 1.5;
  }
  .pn-empty {
    visibility: hidden;
  }

  /* ---------- 响应式 ---------- */
  @media (max-width: 1023px) {
    .toc {
      display: none;
    }
    .art-body {
      grid-template-columns: minmax(0, 720px);
    }
    .art {
      padding-top: 34px;
    }
  }
  @media (max-width: 640px) {
    .pn {
      grid-template-columns: 1fr;
    }
    .pn-next {
      text-align: left;
      align-items: flex-start;
    }
    .art-body {
      padding: 0 4px;
    }
  }
</style>
